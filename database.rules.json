{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[A-Z0-9]{6}$/)",
        ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid && $room.matches(/^[A-Z0-9]{6}$/)",
        ".validate": "newData.hasChildren(['host','created','closed','game'])",
        "host": {
          ".validate": "newData.isString() && newData.val() === auth.uid && !data.exists()"
        },
        "created": {
          ".validate": "newData.isNumber() && !data.exists() && newData.val() === now"
        },
        "closed": {
          ".write": "auth != null && (root.child('rooms').child($room).child('host').val() === auth.uid || root.child('rooms').child($room).child('guest').val() === auth.uid) && newData.isBoolean() && (newData.val() === true || (newData.val() === false && root.child('rooms').child($room).child('created').val() > now - 86400000))",
          ".validate": "newData.isBoolean()"
        },
        "guest": {
          ".write": "auth != null && !data.exists() && newData.parent().child('host').exists() && newData.parent().child('host').val() !== auth.uid && newData.parent().child('closed').val() === false && newData.parent().child('created').val() > now - 86400000",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "game": {
          ".write": "auth != null && (root.child('rooms').child($room).child('host').val() === auth.uid || root.child('rooms').child($room).child('guest').val() === auth.uid) && root.child('rooms').child($room).child('closed').val() === false && root.child('rooms').child($room).child('created').val() > now - 86400000 && newData.exists()",
